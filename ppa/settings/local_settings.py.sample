# Local settings for ppa-reuse
# Copy to ppa/settings/local_settings.py and fill in values.
# This file must NOT be committed to version control.

import os

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# REQUIRED in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = ''

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Default name and user are both "ppa", host is localhost:5433 (Docker default).
# Override only what differs from the base settings.
# DATABASES["default"]["NAME"] = "ppa"
# DATABASES["default"]["USER"] = "ppa"
DATABASES["default"]["PASSWORD"] = "ppa"
# DATABASES["default"]["HOST"] = "localhost"
# DATABASES["default"]["PORT"] = "5433"

# ---------------------------------------------------------------------------
# Solr
# ---------------------------------------------------------------------------

# Default collection and configset are both "ppa" at http://localhost:8983/solr/
SOLR_CONNECTIONS["default"].update(
    {
        "URL": "http://localhost:8983/solr/",
        # "COLLECTION": "ppa",
        # "CONFIGSET": "ppa",
        "TEST": {"COMMITWITHIN": 100},
    }
)

# ---------------------------------------------------------------------------
# Adapter system
# ---------------------------------------------------------------------------

# Directory that contains adapter subdirectories (each with an adapter.yaml).
# Defaults to examples/adapters/ in the repo root.
# ADAPTERS_DIR = "/path/to/your/adapters"

# Name of the active adapter (must be a subdirectory under ADAPTERS_DIR).
# Leave unset to run without any adapter (shows default PPA interface).
# ARCHIVE_ADAPTER = "ia_prosody"

# ---------------------------------------------------------------------------
# Internet Archive (optional)
# ---------------------------------------------------------------------------

# Email shown in HTTP From header for IA API requests (good practice).
# TECHNICAL_CONTACT = "your-email@institution.edu"

# S3-style credentials — only needed for restricted/non-public IA items.
# Most public-domain texts do not require these.
# IA_ACCESS_KEY = ""
# IA_SECRET_KEY = ""

# ---------------------------------------------------------------------------
# HathiTrust (optional — only needed if enable_hathi waffle switch is on)
# ---------------------------------------------------------------------------

# Local path to hathi pairtree data provided via rsync.
# HATHI_DATA = "/path/to/hathi_pairtree_root"

# Optionally override the HathiTrust rsync server and path.
# HATHITRUST_RSYNC_SERVER = ""
# HATHITRUST_RSYNC_PATH = ""

# ---------------------------------------------------------------------------
# Gale / ECCO (optional — only needed if enable_hathi/gale switch is on)
# ---------------------------------------------------------------------------

# GALE_API_USERNAME = ""
# MARC_DATA = ""           # local path for cached MARC records
# GALE_LOCAL_OCR = ""      # local path for Gale OCR data

# ---------------------------------------------------------------------------
# EEBO-TCP (optional)
# ---------------------------------------------------------------------------

# Local path for EEBO-TCP XML and MARC files named by TCP id.
# EEBO_DATA = ""

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------

# INCLUDE_ANALYTICS = True
# GTAGS_ANALYTICS_ID = "G-XXXXXXXXXX"
# PLAUSIBLE_ANALYTICS_SCRIPT = "https://plausible.io/js/script.outbound-links.js"
# PLAUSIBLE_ANALYTICS_404s = True

# ---------------------------------------------------------------------------
# Email / admin notifications (optional)
# ---------------------------------------------------------------------------

# ADMINS = [("Your Name", "your-email@institution.edu")]
# SERVER_EMAIL = "server@institution.edu"
# EMAIL_SUBJECT_PREFIX = "[PPA] "

# ---------------------------------------------------------------------------
# Development helpers (optional)
# ---------------------------------------------------------------------------

# Show a test-site warning banner.
# SHOW_TEST_WARNING = True

# Logging — uncomment to see debug output during development.
# LOGGING = {
#     "version": 1,
#     "disable_existing_loggers": False,
#     "handlers": {
#         "console": {"class": "logging.StreamHandler", "level": "DEBUG"},
#     },
#     "loggers": {
#         "ppa": {"handlers": ["console"], "level": "DEBUG", "propagate": False},
#     },
# }
